{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewartandco.org/schemas/research_card.schema.json",
  "title": "Research Card v1",
  "type": "object",
  "required": ["card_id", "version", "created_utc", "source", "claim", "quote", "tags", "testability", "extraction", "review"],
  "additionalProperties": false,
  "properties": {
    "card_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "version": {"const": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["type", "title", "locator", "credibility_tier"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["paper", "book", "blog", "forum", "filing", "dataset_doc"]},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "items": {"type": "string"}},
        "year": {"type": ["integer", "null"]},
        "locator": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "isbn": {"type": ["string", "null"]},
        "credibility_tier": {"enum": ["peer_reviewed", "practitioner", "gray"]}
      },
      "anyOf": [
        {"properties": {"url": {"type": "string"}}, "required": ["url"]},
        {"properties": {"doi": {"type": "string"}}, "required": ["doi"]},
        {"properties": {"isbn": {"type": "string"}}, "required": ["isbn"]}
      ]
    },
    "claim": {"type": "string", "minLength": 20, "maxLength": 500},
    "quote": {"type": "string", "minLength": 20},
    "tags": {
      "type": "object",
      "required": ["asset_classes", "topics", "horizon"],
      "additionalProperties": false,
      "properties": {
        "asset_classes": {"type": "array", "minItems": 1, "items": {"enum": ["futures", "equities", "crypto", "fx", "options", "rates", "commodities", "cross"]}},
        "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "horizon": {"enum": ["intraday", "daily", "weekly", "monthly", "multi_month"]}
      }
    },
    "testability": {
      "type": "object",
      "required": ["score", "data_required"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "data_required": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": ["string", "null"]}
      }
    },
    "links": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}},
    "relation": {
      "type": "object",
      "additionalProperties": {"enum": ["extends", "contradicts", "duplicates", "cites", "supersedes"]}
    },
    "extraction": {
      "type": "object",
      "required": ["agent", "model", "pipeline_version", "run_id"],
      "additionalProperties": false,
      "properties": {
        "agent": {"type": "string"},
        "model": {"type": "string"},
        "pipeline_version": {"type": "string"},
        "run_id": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected"]},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_utc": {"type": ["string", "null"], "format": "date-time"},
        "reject_reason": {"enum": ["off_topic", "quote_not_found", "claim_not_supported", "duplicate", null]}
      }
    }
  }
}
